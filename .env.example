# ============================================================
# GymAI - Variables de entorno
# Copiar a .env.local y completar. NUNCA commitear valores reales.
# FIX: los nombres anteriores (JWT_SECRET, ENCRYPTION_MASTER_KEY) no coincidían con los que
# lee el código (JWT_ACCESS_SECRET, APP_MASTER_KEY), por lo que en producción se usaban en
# silencio claves por defecto públicas. Ahora, si faltan, la app no arranca en producción.
# ============================================================

# Base de datos: archivo SQLite local para desarrollo
DATABASE_URL="local.db"

# Producción (Vercel): base Turso/libSQL. Si están definidas, se usan en lugar del archivo local.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Zona horaria operativa (vencimientos, heatmap)
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# --- Secretos (generar con: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Clave AES-256 de fichas médicas: EXACTAMENTE 64 caracteres hex (32 bytes)
APP_MASTER_KEY=""
BLIND_INDEX_SALT=""

# Secreto HMAC compartido con la pasarela de pagos (sin él, el webhook se rechaza)
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# Datos de cobro que se muestran a los socios en los recordatorios por WhatsApp (opcional)
NEXT_PUBLIC_GYM_PAYMENT_ALIAS=""
NEXT_PUBLIC_GYM_PAYMENT_CVU=""

# Carga de datos demo en producción (por defecto deshabilitada)
ALLOW_DEMO_SEED="false"

# Sólo para scripts/provision-accounts.ts
PROVISION_MASTER_PASSWORD=""
PROVISION_GYM_PASSWORD=""
